-- 22) Dark green Rotation: a cross that turns + into x (Cubic Out), waits 2s, turns x back into +, repeats
table.insert(Crosshairs, {
	Name = "Dark green Rotation",
	Build = function(holder)
		local DARK_GREEN = Color3.fromRGB(10, 125, 55)
		local SPIN_TIME = 0.55 -- how long each quarter-of-a-quarter turn (45 degrees) takes
		local COOLDOWN = 2 -- wait between turns
		local STEP = COOLDOWN + SPIN_TIME
		local BLUR_LAG = 0.02 -- seconds each blur ghost trails behind

		-- angle of the cross at time t. It starts as "+", waits 2s, turns 45 degrees into "x",
		-- waits 2s, turns another 45 degrees back into "+" (a cross looks identical every 90 degrees), and so on.
		local function angleAt(t)
			if t < 0 then
				return 0
			end
			local n = math.floor(t / STEP)
			local local_t = t - n * STEP
			local a = 0
			if local_t >= COOLDOWN then
				a = TweenService:GetValue((local_t - COOLDOWN) / SPIN_TIME, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out)
			end
			return (n + a) * 45
		end

		local function newCross(transparency)
			local rotor = make("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromOffset(40, 40),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Parent = holder,
			})
			local parts = {
				bar(rotor, 0, -10, 3, 12, DARK_GREEN),
				bar(rotor, 0, 10, 3, 12, DARK_GREEN),
				bar(rotor, -10, 0, 12, 3, DARK_GREEN),
				bar(rotor, 10, 0, 12, 3, DARK_GREEN),
			}
			for _, p in ipairs(parts) do
				p.BackgroundTransparency = transparency
			end
			return rotor
		end

		-- motion blur = faded copies of the cross at slightly earlier moments (only visible while it spins)
		local ghosts = {}
		for i, a in ipairs({ 0.55, 0.72, 0.85 }) do
			ghosts[i] = newCross(a)
		end
		local main = newCross(0)
		dot(holder, 3, DARK_GREEN)

		return function(elapsed)
			local a = angleAt(elapsed)
			main.Rotation = a
			local spinning = angleAt(elapsed - 0.02) ~= a
			for i, g in ipairs(ghosts) do
				g.Visible = spinning
				g.Rotation = angleAt(elapsed - i * BLUR_LAG)
			end
		end
	end,
})

