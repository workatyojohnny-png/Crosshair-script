-- Filtering / refreshing
----------------------------------------------------------------
local function matches(i)
	local d = cardData[i]
	if searchText ~= "" and not string.find(string.lower(Crosshairs[i].Name), searchText, 1, true) then
		return false
	end
	if currentFilter == "Favorites" then
		return favorites[i] == true
	elseif currentFilter == "Animated" then
		return d.kind == "Animated"
	elseif currentFilter == "Static" then
		return d.kind == "Static"
	end
	return true
end

function refreshCards()
	local shown, favCount = 0, 0
	for i, d in ipairs(cardData) do
		local ok = matches(i)
		d.card.Visible = ok
		if ok then
			shown += 1
		end
		if favorites[i] then
			favCount += 1
		end
		local eq = (i == equippedIndex)
		d.stroke.Color = eq and ACCENT or COL_BORDER
		d.stroke.Thickness = eq and 2 or 1
		d.pill.Visible = eq
		d.star.Text = favorites[i] and "\u{2605}" or "\u{2606}"
		d.star.TextColor3 = favorites[i] and COL_GOLD or COL_SUB
		-- favorites float to the top
		d.card.LayoutOrder = favorites[i] and (i - 1000) or i
	end

	emptyLabel.Visible = (shown == 0)
	tabButtons.Favorites.Text = "Favorites (" .. favCount .. ")"
	for name, b in pairs(tabButtons) do
		local active = (name == currentFilter)
		b.BackgroundColor3 = active and ACCENT or COL_CARD
		b.TextColor3 = active and COL_DARKTEXT or COL_SUB
	end
	footer.Text = string.format(
		"Showing %d of %d   \u{2022}   Equipped: %s",
		shown,
		#Crosshairs,
		Crosshairs[equippedIndex].Name
	)
end

local detailHolder, detailIndex
function showDetail(index)
	shownIndex = index
	local def = Crosshairs[index]

	-- only rebuild the preview when the crosshair actually changes
	if detailIndex ~= index or not (detailHolder and detailHolder.Parent) then
		for _, c in ipairs(previewWrapper:GetChildren()) do
			if c.Name == "Holder" then
				c:Destroy()
			end
		end
		detailHolder = nil
		detailIndex = index
		if def.Build then
			detailHolder = mount(def, previewWrapper)
		end
	end
	offLabel.Visible = (def.Build == nil)

	nameLabel.Text = def.Name
	local eq = (index == equippedIndex)
	typeLabel.Text = cardData[index].kind .. (eq and "   \u{2022}   Equipped" or "")

	if eq and index ~= 1 then
		equipBtn.Text = "Unequip"
		equipBtn.BackgroundColor3 = COL_RED
		equipBtn.TextColor3 = COL_TEXT
	elseif eq then
		equipBtn.Text = "Equipped"
		equipBtn.BackgroundColor3 = COL_CARD
		equipBtn.TextColor3 = COL_SUB
	else
		equipBtn.Text = "Equip"
		equipBtn.BackgroundColor3 = ACCENT
		equipBtn.TextColor3 = COL_DARKTEXT
	end

	favBtn.Text = favorites[index] and "\u{2605}  Remove from favorites" or "\u{2606}  Add to favorites"
	favBtn.TextColor3 = favorites[index] and COL_GOLD or COL_TEXT
	favBtn.Visible = (index ~= 1)
end

