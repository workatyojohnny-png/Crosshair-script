local MIN_SCALE, MAX_SCALE = 0.5, 2.5

local function setSize(scale)
	scale = math.clamp(scale, MIN_SCALE, MAX_SCALE)
	scale = math.floor(scale * 20 + 0.5) / 20
	liveScale.Scale = scale
	local a = (scale - MIN_SCALE) / (MAX_SCALE - MIN_SCALE)
	fill.Size = UDim2.fromScale(a, 1)
	knob.Position = UDim2.fromScale(a, 0.5)
	sizeValue.Text = string.format("%.2fx", scale)
end

local function sliderFromInput(input)
	local a = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
	setSize(MIN_SCALE + a * (MAX_SCALE - MIN_SCALE))
end

