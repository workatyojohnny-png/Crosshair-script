-- 16) Yellow Oscillate: a hollow triangle swings and drifts around a dot that never moves
table.insert(Crosshairs, {
	Name = "Yellow Oscillate",
	Build = function(holder)
		local YELLOW = Color3.fromRGB(255, 225, 40)
		local R = 16 -- triangle size (distance from its center to each corner)
		local THICK = 2
		local BLUR_LAG = 0.03 -- seconds each blur ghost trails behind
		-- The biggest circle that fits inside the triangle has radius R / 2 = 8.
		-- The dot (radius 2.5) stays still at the screen center, so letting the triangle drift
		-- at most 4.5 away always leaves the dot inside, at least 1 pixel clear of every edge.
		local MAX_DRIFT = 4.5

		local corners = { math.rad(-90), math.rad(30), math.rad(150) }

		-- where the triangle is at time t: swing angle + drift (clamped so the dot can't escape)
		local function pose(t)
			local rot = math.rad(math.sin(t * 2.6) * 40)
			local ox = math.sin(t * 3.1) * 3.2
			local oy = math.cos(t * 2.3) * 3.2
			local m = math.sqrt(ox * ox + oy * oy)
			if m > MAX_DRIFT then
				ox = ox / m * MAX_DRIFT
				oy = oy / m * MAX_DRIFT
			end
			return rot, ox, oy
		end

		local function newTriangle(transparency)
			local edges = {}
			for i = 1, 3 do
				edges[i] = make("Frame", {
					AnchorPoint = Vector2.new(0.5, 0.5),
					Size = UDim2.fromOffset(R, THICK),
					BackgroundColor3 = YELLOW,
					BackgroundTransparency = transparency,
					BorderSizePixel = 0,
					Parent = holder,
				})
			end
			return edges
		end

		local function place(edges, t)
			local rot, ox, oy = pose(t)
			local v = {}
			for i, a in ipairs(corners) do
				v[i] = Vector2.new(math.cos(a + rot) * R + ox, math.sin(a + rot) * R + oy)
			end
			for i = 1, 3 do
				local p, q = v[i], v[i % 3 + 1]
				local mid = (p + q) / 2
				local d = q - p
				edges[i].Size = UDim2.fromOffset(d.Magnitude + THICK, THICK)
				edges[i].Position = UDim2.new(0.5, mid.X, 0.5, mid.Y)
				edges[i].Rotation = math.deg(math.atan2(d.Y, d.X))
			end
		end

		-- motion blur ghosts first (behind), then the real triangle, then the fixed dot
		local ghosts = {}
		for i, a in ipairs({ 0.6, 0.78, 0.9 }) do
			ghosts[i] = newTriangle(a)
		end
		local main = newTriangle(0)
		dot(holder, 5, YELLOW) -- never moves

		return function(elapsed)
			place(main, elapsed)
			for i, g in ipairs(ghosts) do
				place(g, elapsed - i * BLUR_LAG)
			end
		end
	end,
})

-- 17) Cyan Lock-On: a hollow square that snaps a quarter turn with a bounce, then holds
table.insert(Crosshairs, {
	Name = "Cyan Lock-On",
	Build = function(holder)
		local CYAN = Color3.fromRGB(60, 235, 255)
		local CYCLE, SPIN = 1.6, 0.5

		local square = make("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(22, 22),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Parent = holder,
		})
		stroke(CYAN, 2, 0).Parent = square
		dot(holder, 3, CYAN)

		return function(elapsed)
			local t = elapsed % CYCLE
			local rot, size = 0, 22
			if t < SPIN then
				local p = t / SPIN
				local a = TweenService:GetValue(p, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
				rot = a * 90 -- a quarter turn looks identical to 0, so it can snap back to 0 afterwards
				size = 22 - math.sin(p * math.pi) * 6 -- squeezes in while turning
			end
			square.Rotation = rot
			square.Size = UDim2.fromOffset(size, size)
		end
	end,
})

