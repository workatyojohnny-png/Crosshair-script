-- 8) Orange Hollow Sphere: eases outward, snaps back linearly, repeats, with motion blur
table.insert(Crosshairs, {
	Name = "Orange Hollow Sphere",
	Build = function(holder)
		local ORANGE = Color3.fromRGB(255, 140, 0)
		local BASE, MAX = 18, 30 -- resting size / expanded size
		local EXPAND_TIME = 0.35 -- eased expand
		local RETURN_TIME = 0.30 -- linear (no easing) return
		local CYCLE = EXPAND_TIME + RETURN_TIME
		local BLUR_LAG = 0.022 -- seconds each blur ghost trails behind

		local function sizeAt(t)
			local c = t % CYCLE
			if c < EXPAND_TIME then
				local a = TweenService:GetValue(c / EXPAND_TIME, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
				return BASE + (MAX - BASE) * a
			end
			local a = (c - EXPAND_TIME) / RETURN_TIME
			return MAX + (BASE - MAX) * a
		end

		local function ring(transparency, thickness)
			return make("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromOffset(BASE, BASE),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Parent = holder,
			}, { corner(100), stroke(ORANGE, thickness, transparency) })
		end

		-- motion blur = faded copies of the ring at earlier moments in time
		local ghosts = {}
		for i, a in ipairs({ 0.55, 0.72, 0.84, 0.92 }) do
			ghosts[i] = ring(a, 2.5)
		end
		local main = ring(0, 2.5)
		dot(holder, 4, ORANGE)

		return function(elapsed)
			local s = sizeAt(elapsed)
			main.Size = UDim2.fromOffset(s, s)
			for i, g in ipairs(ghosts) do
				local gs = sizeAt(elapsed - i * BLUR_LAG)
				g.Size = UDim2.fromOffset(gs, gs)
			end
		end
	end,
})

