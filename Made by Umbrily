----------------------------------------------------------------
-- Open / close animation
----------------------------------------------------------------
local fit = 1
local openAlpha = 0
local targetAlpha = 0

local function applyOpen()
	local a = openAlpha
	windowScale.Scale = fit * (0.88 + 0.12 * a)
	dim.BackgroundTransparency = 1 - 0.4 * a
	blur.Size = 14 * a
end

local function updateFit()
	local s = gui.AbsoluteSize
	if s.X < 50 or s.Y < 50 then
		local cam = workspace.CurrentCamera
		if cam then
			s = cam.ViewportSize
		end
	end
	fit = math.clamp(math.min(s.X / 820, s.Y / 520), 0.45, 1.25)
	applyOpen()
end
gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateFit)

RunService.RenderStepped:Connect(function(dt)
	if openAlpha == targetAlpha then
		return
	end
	openAlpha += (targetAlpha - openAlpha) * math.min(1, dt * 14)
	if math.abs(targetAlpha - openAlpha) < 0.005 then
		openAlpha = targetAlpha
	end
	applyOpen()
	if openAlpha == 0 and targetAlpha == 0 then
		window.Visible = false
		dim.Visible = false
	end
end)

function setOpen(open)
	if open == inventoryOpen then
		return
	end
	inventoryOpen = open
	refreshMouseIcon()
	targetAlpha = open and 1 or 0
	if open then
		window.Visible = true
		dim.Visible = true
		showDetail(selectedIndex)
	end
end

