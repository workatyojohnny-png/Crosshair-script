-- Mounting + animation loop
----------------------------------------------------------------
local updaters = {}
local startTime = os.clock()

RunService.RenderStepped:Connect(function()
	local elapsed = os.clock() - startTime
	for holder, fn in pairs(updaters) do
		if holder.Parent == nil then
			updaters[holder] = nil
		else
			fn(elapsed)
		end
	end
end)

local function mount(def, parent)
	local holder = make("Frame", {
		Name = "Holder",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Parent = parent,
	})
	if def.Build then
		local update = def.Build(holder)
		if update then
			updaters[holder] = update
			holder.Destroying:Connect(function()
				updaters[holder] = nil
			end)
		end
	end
	return holder
end

